{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/schemas/error-envelope-v1.json",
  "title": "APGIC Error Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message_safe",
    "correlation_id",
    "retryable"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message_safe": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "field_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentation_ref": {
      "type": "string"
    }
  }
}
