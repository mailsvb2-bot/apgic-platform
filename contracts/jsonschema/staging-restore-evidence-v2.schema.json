{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/staging-restore-evidence-v2.schema.json",
  "title": "APGIC Staging Restore Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "candidate_sha",
    "observed_at",
    "backup_file_sha256",
    "measured_backup_rpo_seconds",
    "measured_restore_rto_ms",
    "source_table_count",
    "restored_table_count",
    "required_table_count",
    "production_evidence",
    "business_probe_identity_source_count",
    "business_probe_identity_restored_count",
    "business_probe_organization_source_count",
    "business_probe_organization_restored_count",
    "integrity_probe_audit_trigger_count",
    "integrity_probe_ledger_trigger_count",
    "integrity_probe_direction_trigger_count",
    "integrity_probe_product_owner_trigger_count",
    "integrity_probe_booking_transition_trigger_count",
    "integrity_probe_orders_append_only_trigger_count",
    "business_probes_passed",
    "integrity_probes_passed"
  ],
  "properties": {
    "schema_version": {
      "const": "staging-restore-evidence-v2"
    },
    "evidence_type": {
      "const": "STAGING_RESTORE_DRILL"
    },
    "candidate_sha": {
      "type": "string",
      "minLength": 7
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "backup_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measured_backup_rpo_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "measured_restore_rto_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_table_count": {
      "type": "integer",
      "minimum": 1
    },
    "restored_table_count": {
      "type": "integer",
      "minimum": 1
    },
    "required_table_count": {
      "type": "integer",
      "minimum": 1
    },
    "production_evidence": {
      "const": false
    },
    "business_probe_identity_source_count": {
      "type": "integer",
      "minimum": 1
    },
    "business_probe_identity_restored_count": {
      "type": "integer",
      "minimum": 1
    },
    "business_probe_organization_source_count": {
      "type": "integer",
      "minimum": 1
    },
    "business_probe_organization_restored_count": {
      "type": "integer",
      "minimum": 1
    },
    "integrity_probe_audit_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "integrity_probe_ledger_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "integrity_probe_direction_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "integrity_probe_product_owner_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "integrity_probe_booking_transition_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "integrity_probe_orders_append_only_trigger_count": {
      "type": "integer",
      "const": 1
    },
    "business_probes_passed": {
      "const": true
    },
    "integrity_probes_passed": {
      "const": true
    }
  }
}
