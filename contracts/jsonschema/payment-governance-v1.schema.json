{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/payment-governance-v1.schema.json",
  "title": "APGIC Payment Governance v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id","config_version","supersedes_config_id","status","priority",
        "routing_weight_bps","scope","credential_version_ref","change_kind",
        "actor_id","reason","authorization_audit_id","change_audit_id","effective_from"
      ],
      "properties": {
        "provider_id": {"type":"string","minLength":1},
        "config_version": {"type":"string","minLength":1},
        "supersedes_config_id": {"type":"string","minLength":1},
        "status": {"enum":["ACTIVE","DEGRADED","PAUSED","DISABLED"]},
        "priority": {"type":"integer","minimum":0},
        "routing_weight_bps": {"type":"integer","minimum":0,"maximum":10000},
        "scope": {
          "type":"object",
          "additionalProperties": false,
          "required":["jurisdictions","currencies","methods","rails"],
          "properties": {
            "jurisdictions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
            "currencies":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z]{3}$"}},
            "methods":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
            "rails":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
          }
        },
        "credential_version_ref":{"type":"string","minLength":1},
        "change_kind":{"enum":["ACTIVATE","PRIORITIZE","SCOPE","PAUSE","ROTATE_CREDENTIAL","DISABLE","ROLLBACK"]},
        "actor_id":{"type":"string","minLength":1},
        "reason":{"type":"string","minLength":1},
        "authorization_audit_id":{"type":"string","minLength":1},
        "change_audit_id":{"type":"string","minLength":1},
        "effective_from":{"type":"string","format":"date-time"}
      }
    },
    "health_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_config_id","health","conversion_rate_bps","latency_p95_ms",
        "provider_reported_fee_bps","reconciliation_pending_count",
        "reconciliation_mismatch_count","guardrail_action","evidence_refs","observed_at"
      ],
      "properties": {
        "provider_config_id":{"type":"string","minLength":1},
        "health":{"enum":["HEALTHY","DEGRADED","UNAVAILABLE"]},
        "conversion_rate_bps":{"type":"integer","minimum":0,"maximum":10000},
        "latency_p95_ms":{"type":"integer","minimum":0},
        "provider_reported_fee_bps":{"type":"integer","minimum":0,"maximum":10000},
        "reconciliation_pending_count":{"type":"integer","minimum":0},
        "reconciliation_mismatch_count":{"type":"integer","minimum":0},
        "guardrail_action":{"enum":["ALLOW_NEW_ATTEMPTS","BLOCK_NEW_ATTEMPTS"]},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "observed_at":{"type":"string","format":"date-time"}
      }
    }
  },
  "anyOf":[{"required":["config_change"]},{"required":["health_snapshot"]}]
}
