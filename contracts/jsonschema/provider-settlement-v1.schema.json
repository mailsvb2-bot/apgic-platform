{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/provider-settlement-v1.schema.json",
  "title": "APGIC Provider Settlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["commission_snapshot", "settlement_instruction", "payout_instruction"],
  "properties": {
    "commission_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id","policy_version","demand_source","product_ref","jurisdiction","basis_points","basis_amount_minor","commission_minor","currency","platform_fee_recipient_ref"],
      "properties": {
        "order_id":{"type":"string","minLength":1},
        "policy_version":{"type":"string","minLength":1},
        "demand_source":{"type":"string","minLength":1},
        "product_ref":{"type":"string","minLength":1},
        "jurisdiction":{"type":"string","minLength":1},
        "basis_points":{"type":"integer","minimum":0,"maximum":10000},
        "basis_amount_minor":{"type":"integer","minimum":1},
        "commission_minor":{"type":"integer","minimum":0},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "platform_fee_recipient_ref":{"type":"string","minLength":1}
      }
    },
    "settlement_instruction": {
      "type":"object",
      "additionalProperties":false,
      "required":["provider_id","execution_owner","order_id","total_amount_minor","currency","allocations"],
      "properties":{
        "provider_id":{"type":"string","minLength":1},
        "execution_owner":{"const":"EXTERNAL_PROVIDER"},
        "order_id":{"type":"string","minLength":1},
        "total_amount_minor":{"type":"integer","minimum":1},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "allocations":{"type":"array","minItems":1,"items":{"type":"object"}}
      }
    },
    "payout_instruction": {
      "type":"object",
      "additionalProperties":false,
      "required":["provider_id","execution_owner","beneficiary_ref","amount_minor","currency","compliance_evidence_ref"],
      "properties":{
        "provider_id":{"type":"string","minLength":1},
        "execution_owner":{"const":"EXTERNAL_PROVIDER"},
        "beneficiary_ref":{"type":"string","minLength":1},
        "amount_minor":{"type":"integer","minimum":1},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "compliance_evidence_ref":{"type":"string","minLength":1}
      }
    }
  }
}
