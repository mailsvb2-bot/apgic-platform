{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/pricing-commission-policy-v1.schema.json",
  "title": "APGIC Pricing and Commission Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "production_approved",
    "policy_kind",
    "unknown_path",
    "monetized_paths"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "enum": ["CI_ONLY", "PRODUCTION"] },
    "production_approved": { "type": "boolean" },
    "policy_kind": { "const": "PRICING_COMMISSION" },
    "unknown_path": { "const": "BLOCK" },
    "monetized_paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pricing_policy_version",
          "commission_policy_version",
          "price_source_ref",
          "currency",
          "commission"
        ],
        "properties": {
          "pricing_policy_version": { "type": "string", "minLength": 1 },
          "commission_policy_version": { "type": "string", "minLength": 1 },
          "price_source_ref": { "type": "string", "minLength": 1 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "commission": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "basis_points"],
            "properties": {
              "kind": { "const": "PERCENT_BPS" },
              "basis_points": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          }
        }
      }
    }
  }
}
