{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/legal-acceptance-v1.schema.json",
  "title": "APGIC Legal Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "identity_id",
    "document_id",
    "document_version",
    "evidence_hash",
    "accepted_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "identity_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "document_version": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "format": "date-time"}
  }
}
