{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/service-principal-v1.schema.json",
  "title": "APGIC Service Principal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "scopes"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {"const": "*"}
      }
    }
  }
}
