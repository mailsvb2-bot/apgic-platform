{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/provider-matrix-v1.schema.json",
  "title": "APGIC Provider Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "production_approved",
    "capabilities",
    "providers"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "CI_ONLY",
        "PRODUCTION"
      ]
    },
    "production_approved": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "primary_provider",
          "fallback_providers",
          "environment",
          "jurisdictions",
          "regions",
          "credential_owner",
          "credential_ref_contract",
          "scopes",
          "webhook_event_contract_version",
          "data_classes_transmitted",
          "retention_subprocessor_terms_ref",
          "timeout_seconds",
          "retry_policy",
          "idempotency_contract",
          "reconciliation_method",
          "health_policy",
          "kill_switch",
          "degraded_behavior",
          "certification_status",
          "exit_semantics",
          "provider_neutral_contract"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "primary_provider": {
            "type": "string",
            "minLength": 1
          },
          "fallback_providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "degraded_behavior": {
            "type": "string",
            "minLength": 1
          },
          "certification_status": {
            "type": "string",
            "minLength": 1
          },
          "exit_semantics": {
            "type": "string",
            "minLength": 1
          },
          "provider_neutral_contract": {
            "const": true
          },
          "environment": {
            "type": "string",
            "enum": [
              "CI",
              "PRODUCTION"
            ]
          },
          "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "credential_owner": {
            "type": "string",
            "minLength": 1
          },
          "credential_ref_contract": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(secretref|managed-secret)://"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "webhook_event_contract_version": {
            "type": "string",
            "minLength": 1
          },
          "data_classes_transmitted": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retention_subprocessor_terms_ref": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "retry_policy": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_contract": {
            "type": "string",
            "minLength": 1
          },
          "reconciliation_method": {
            "type": "string",
            "minLength": 1
          },
          "health_policy": {
            "type": "string",
            "minLength": 1
          },
          "kill_switch": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "certified",
          "capabilities"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "certified": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
