{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/service-credential-metadata-v1.schema.json",
  "title": "APGIC Service Credential Metadata v1",
  "description": "Non-secret lifecycle metadata. Plaintext secret and secret digest are never serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_id", "credential_version", "not_before", "expires_at"],
  "properties": {
    "principal_id": {"type": "string", "minLength": 1},
    "credential_version": {"type": "string", "minLength": 1},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
