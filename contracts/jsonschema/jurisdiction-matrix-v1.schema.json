{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.ru/contracts/jurisdiction-matrix-v1.schema.json",
  "title": "APGIC Jurisdiction Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "production_approved", "unknown_combination", "jurisdictions"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["CI_ONLY", "PRODUCTION"]},
    "production_approved": {"type": "boolean"},
    "unknown_combination": {"const": "BLOCK"},
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "enabled",
          "product_types",
          "currencies",
          "legal_financial_roles"
        ],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "product_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "currencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "legal_financial_roles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seller_or_service_provider",
              "commercial_owner",
              "payment_recipient",
              "fiscal_responsibility",
              "refund_responsibility",
              "payout_beneficiary"
            ],
            "properties": {
              "seller_or_service_provider": {"type": "string", "minLength": 1},
              "commercial_owner": {"type": "string", "minLength": 1},
              "payment_recipient": {"type": "string", "minLength": 1},
              "fiscal_responsibility": {"type": "string", "minLength": 1},
              "refund_responsibility": {"type": "string", "minLength": 1},
              "payout_beneficiary": {"type": "string", "minLength": 1}
            }
          },
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
