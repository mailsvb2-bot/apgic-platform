{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.local/evidence/release-evidence-v2.schema.json",
  "title": "APGIC Release Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "production_release",
    "candidate_sha",
    "generated_at",
    "surfaces",
    "gate_results",
    "requirement_evidence",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "release-evidence-v2" },
    "evidence_class": { "enum": ["CI_CANDIDATE", "PRODUCTION_RELEASE"] },
    "production_release": { "type": "boolean" },
    "candidate_sha": { "type": "string", "minLength": 7 },
    "generated_at": { "type": "string", "format": "date-time" },
    "surfaces": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["WEB", "PWA", "IOS", "ANDROID"] }
    },
    "gate_results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["success", "failure", "cancelled", "skipped"]
      }
    },
    "requirement_evidence": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^APGIC-[A-Z0-9-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "proven_evidence", "unproven_evidence"],
          "properties": {
            "status": { "enum": ["CI_PROVEN", "PARTIAL", "UNPROVEN"] },
            "proven_evidence": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gates", "proof_refs"],
                "properties": {
                  "gates": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "proof_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "unproven_evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
