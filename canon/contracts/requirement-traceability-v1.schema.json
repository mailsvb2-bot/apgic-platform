{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apgic.local/contracts/requirement-traceability-v1.schema.json",
  "title": "APGIC Requirement Traceability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "owner_domain",
    "dependencies",
    "implementation_refs",
    "contract_refs",
    "test_refs",
    "evidence_refs"
  ],
  "properties": {
    "requirement_id": {"type":"string","pattern":"^APGIC-[A-Z0-9_]+-[0-9]{3}$"},
    "owner_domain": {"type":"string","minLength":1},
    "dependencies": {"type":"array","items":{"type":"string","pattern":"^APGIC-[A-Z0-9_]+-[0-9]{3}$"},"uniqueItems":true},
    "implementation_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "contract_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "test_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
