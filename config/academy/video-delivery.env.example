# Academy video transport. Only the transport selector changes.
# Default: direct Yandex Disk via the protected APGIC gateway.
APGIC_ACADEMY_VIDEO_DELIVERY_MODE=direct

# Future activation, AFTER a real CDN_PROVIDER adapter is registered and
# independently certified for the deployed source SHA:
# APGIC_ACADEMY_VIDEO_DELIVERY_MODE=cdn
#
# This switch never supplies provider credentials or grants permission by
# itself. CDN remains HTTP 503 until its production adapter is connected.
# Publication stays behind APGIC_ACADEMY_VIDEO_PUBLISH_ENABLED and immutable
# provider/payment/revocation acceptance; never bypass those checks.

# Explicit, default-off opt-in for single-label Yandex storage nodes.
# Enable only after independently validating redirect and SSRF guard evidence.
# APGIC_YANDEX_TRUST_STORAGE_NODES=true
