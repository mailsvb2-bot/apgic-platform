    {"order": 3, "branch": "feat/consultation-runtime", "owner": "consultation-runtime", "profile": "R3", "launch_dependency": true, "dependencies": ["feat/booking-complete"], "purpose": "Authorization -> ready/join -> provider lifecycle -> completion and recovery"},
    {"order": 4, "branch": "feat/client-personal", "owner": "client-personal", "profile": "POST-LAUNCH", "launch_dependency": false, "dependencies": ["feat/booking-complete"], "purpose": "Client-owned history and preferences; R5-type extension, not R0-R4 launch condition"},
    {"order": 5, "branch": "feat/ai-persona", "owner": "ai-persona", "profile": "POST-LAUNCH", "launch_dependency": false, "dependencies": ["feat/consultation-runtime"], "purpose": "Replaceable PersonaProvider and consent/privacy separation"},
    {"order": 6, "branch": "feat/instant-consultation", "owner": "instant-consultation", "profile": "R6", "launch_dependency": false, "dependencies": ["feat/consultation-runtime"], "purpose": "Duty/Now, no phantom booking/payment shortcut"},
    {"order": 7, "branch": "feat/academy-edtech", "owner": "academy-edtech", "profile": "R8", "launch_dependency": false, "dependencies": ["feat/booking-complete"], "purpose": "Course content, entitlements and durable learning state"},
    {"order": 8, "branch": "feat/groups-live-events", "owner": "groups-live-events", "profile": "R9", "launch_dependency": false, "dependencies": ["feat/booking-complete", "feat/consultation-runtime"], "purpose": "Capacity, group entitlements, attendance and provider room access"},
