    {"phase": "R4", "owner": "platform-readiness", "input": "platform financial/payment core + providers", "proof": "commission -> signed payout/settlement -> ledger/reconciliation and native release evidence"},
    {"phase": "POST-LAUNCH", "owner": "respective-lane-owners", "input": "R5/R6/R8/R9/Growth lanes", "proof": "own scoped production journeys, do not expand Launch v1"}
